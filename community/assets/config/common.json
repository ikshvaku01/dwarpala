{
  "groups": {
    "secrets": {
      "default": true,
      "description": "Environment files, cloud/CI credentials, tokens and state files that commonly hold secrets",
      "ignore": [
        ".env",
        "*.env",
        ".env.local",
        ".env.*.local",
        ".env.development",
        ".env.production",
        ".env.staging",
        ".env.test",
        ".envrc",
        ".dev.vars",
        "secrets.yml",
        "secrets.yaml",
        "secrets.json",
        "secrets.toml",
        "*.secret",
        "*.secrets",
        "credentials.json",
        "service-account*.json",
        "master.key",
        "*.tfvars",
        "*.tfstate",
        "*.tfstate.*",
        ".terraform/",
        ".vault_pass",
        ".vault-pass",
        ".htpasswd",
        ".netrc",
        ".npmrc",
        ".pypirc",
        ".dockercfg",
        ".docker/",
        ".aws/",
        ".azure/",
        ".kube/",
        "kubeconfig",
        "*.kubeconfig",
        ".boto",
        ".s3cfg"
      ]
    },
    "keys": {
      "default": true,
      "description": "Private keys, certificates, keystores, SSH and GnuPG material",
      "ignore": [
        "*.pem",
        "*.key",
        "*.p12",
        "*.pfx",
        "*.jks",
        "*.keystore",
        "*.truststore",
        "*.crt",
        "*.cer",
        "*.ppk",
        "id_rsa*",
        "id_dsa*",
        "id_ecdsa*",
        "id_ed25519*",
        ".ssh/",
        "known_hosts",
        "authorized_keys",
        ".gnupg/",
        "private-keys-v1.d/",
        "openpgp-revocs.d/",
        "secring.*",
        "pubring.*",
        "trustdb.gpg",
        "*.gpg",
        "*.pgp",
        "*.asc",
        "*.kbx",
        "*.kdbx",
        "*.keychain",
        "*.keychain-db"
      ]
    },
    "os": {
      "default": true,
      "description": "Operating-system metadata and thumbnail caches",
      "ignore": [
        ".DS_Store",
        ".AppleDouble",
        ".LSOverride",
        "._*",
        ".Spotlight-V100/",
        ".Trashes/",
        ".fseventsd/",
        "Thumbs.db",
        "ehthumbs.db",
        "desktop.ini",
        "$RECYCLE.BIN/",
        "*.lnk",
        ".directory"
      ]
    },
    "editors": {
      "default": true,
      "description": "IDE and editor state, swap and backup files",
      "ignore": [
        ".idea/",
        ".vscode/",
        ".vs/",
        ".fleet/",
        ".history/",
        ".settings/",
        ".project",
        ".classpath",
        "*.iml",
        "*.ipr",
        "*.iws",
        "*.suo",
        "*.user",
        "*.code-workspace",
        "*.sublime-project",
        "*.sublime-workspace",
        "*.swp",
        "*.swo",
        "*~",
        ".#*"
      ]
    },
    "vcs": {
      "default": true,
      "description": "Other version-control metadata (.git is already covered by baseIgnore)",
      "ignore": [
        ".svn/",
        ".hg/",
        ".bzr/",
        "CVS/",
        ".gitkeep"
      ]
    },
    "temp_generated": {
      "default": true,
      "description": "Logs, temp/backup files, tool caches, minified and source-map output",
      "ignore": [
        "*.log",
        "npm-debug.log*",
        "yarn-debug.log*",
        "yarn-error.log*",
        "pnpm-debug.log*",
        "*.tmp",
        "*.temp",
        "*.bak",
        "*.orig",
        "*.rej",
        "*.pid",
        "*.seed",
        ".eslintcache",
        ".stylelintcache",
        "*.tsbuildinfo",
        "*.min.js",
        "*.min.css",
        "*.js.map",
        "*.css.map"
      ]
    },
    "lockfiles": {
      "default": true,
      "description": "Dependency lock files (large, machine-generated)",
      "ignore": [
        "*.lock",
        "package-lock.json",
        "npm-shrinkwrap.json",
        "pnpm-lock.yaml",
        "bun.lockb",
        "go.sum",
        "gradle.lockfile",
        "packages.lock.json"
      ]
    },
    "binary_media": {
      "default": true,
      "description": "Binary and media files. Non-UTF-8 files still get a header with an empty body in the output, so ignoring them saves tokens",
      "ignore": [
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.gif",
        "*.bmp",
        "*.ico",
        "*.icns",
        "*.webp",
        "*.tif",
        "*.tiff",
        "*.psd",
        "*.heic",
        "*.woff",
        "*.woff2",
        "*.ttf",
        "*.otf",
        "*.eot",
        "*.mp3",
        "*.wav",
        "*.ogg",
        "*.flac",
        "*.mp4",
        "*.mov",
        "*.avi",
        "*.mkv",
        "*.webm",
        "*.zip",
        "*.tar",
        "*.gz",
        "*.tgz",
        "*.bz2",
        "*.xz",
        "*.7z",
        "*.rar",
        "*.zst",
        "*.pdf",
        "*.doc",
        "*.docx",
        "*.xls",
        "*.xlsx",
        "*.ppt",
        "*.pptx",
        "*.exe",
        "*.dll",
        "*.so",
        "*.dylib",
        "*.a",
        "*.o",
        "*.obj",
        "*.lib",
        "*.class",
        "*.jar",
        "*.war",
        "*.bin",
        "*.wasm",
        "*.pdb",
        "*.sqlite",
        "*.sqlite3",
        "*.db",
        "*.mdb"
      ]
    },
    "docs": {
      "default": true,
      "description": "Licence and project-meta documents. Set to false if you want README content in the output: it is often the best one-page summary of a project",
      "ignore": [
        "LICENSE*",
        "LICENCE*",
        "COPYING*",
        "NOTICE",
        "NOTICE.md",
        "NOTICE.txt",
        "AUTHORS",
        "CONTRIBUTORS",
        "CODEOWNERS",
        "README*",
        "CHANGELOG*",
        "CONTRIBUTING*",
        "CODE_OF_CONDUCT*",
        "SECURITY.md"
      ]
    },
    "tool_output": {
      "default": true,
      "description": "Dwarpala's own output, so a timestamped run is never fed back in as input on the next run",
      "ignore": [
        "compiled_output*.txt"
      ]
    },
    "other_ecosystems": {
      "default": true,
      "description": "Build/cache directories for ecosystems with no project-type detector (Gradle, Dart, iOS)",
      "ignore": [".gradle/", ".dart_tool/", ".pub-cache/", "Pods/", "DerivedData/", ".cache/"]
    }
  }
}